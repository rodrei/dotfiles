#!/usr/bin/env zsh
#
# theme — list and switch color themes for the terminal, tmux and neovim.
#
# Each theme is a single palette file: theme/themes/<name>/palette.conf.
# `theme apply <name>` renders that palette into per-tool config under
# ~/.config/theme and tells running programs to pick it up:
#
#   iterm2-profiles.json  dynamic profile "Theme" (also copied into iTerm's
#                         DynamicProfiles folder; iTerm reloads it live)
#   ghostty.conf          included by ~/.config/ghostty/config (also used by cmux)
#   tmux.conf             sourced by ~/.tmux.conf
#   palette.conf          read by neovim (lua/theme.lua) on startup
#   current               the active theme name

emulate -L zsh
set -e -u -o pipefail

THEMES_DIR=${0:A:h}/../theme/themes
THEMES_DIR=${THEMES_DIR:A}
STATE_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/theme
DEFAULT_THEME=selenized-dark

ITERM_GUID=D07F11E5-0000-4000-8000-000000000001
ITERM_PROFILE_NAME=Theme
ITERM_FONT="HackNFM-Regular 15"
ITERM_DYNAMIC_DIR="$HOME/Library/Application Support/iTerm2/DynamicProfiles"

typeset -A P # the loaded palette

die() { print -u2 -- "theme: $*"; exit 1 }

usage() {
  cat <<EOF
usage: theme <command>

  list [--names]   show available themes (* marks the current one)
  current          print the current theme name
  apply <name>     switch every tool to <name>
  setup            first-time setup: apply the current or default theme and
                   make the iTerm "Theme" profile the default profile

Themes are defined in $THEMES_DIR
EOF
}

# ---------------------------------------------------------------- palette ---

load_palette() {
  local file=$1 line key
  P=()
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    P[${line%%=*}]=${line#*=}
  done < $file
  for key in name background_mode nvim_colorscheme background foreground \
             cursor cursor_text selection selection_text color{0..15}; do
    [[ -n ${P[$key]-} ]] || die "$file: missing '$key'"
  done
}

# "#rrggbb" -> "r g b" (decimal)
rgb() { print -- $(( 16#${1[2,3]} )) $(( 16#${1[4,5]} )) $(( 16#${1[6,7]} )) }

# ------------------------------------------------------------- renderers ---

iterm_color() {
  local r g b
  read -r r g b <<< "$(rgb $1)"
  printf '{"Red Component": %.6f, "Green Component": %.6f, "Blue Component": %.6f, "Alpha Component": 1, "Color Space": "sRGB"}' \
    $(( r / 255.0 )) $(( g / 255.0 )) $(( b / 255.0 ))
}

render_iterm() {
  local i
  cat <<EOF
{
  "Profiles": [
    {
      "Name": "$ITERM_PROFILE_NAME",
      "Guid": "$ITERM_GUID",
      "Dynamic Profile Parent Name": "Default",
      "Use Separate Colors for Light and Dark Mode": false,
      "Normal Font": "$ITERM_FONT",
      "Background Color": $(iterm_color ${P[background]}),
      "Foreground Color": $(iterm_color ${P[foreground]}),
      "Bold Color": $(iterm_color ${P[color15]}),
      "Link Color": $(iterm_color ${P[color4]}),
      "Cursor Color": $(iterm_color ${P[cursor]}),
      "Cursor Text Color": $(iterm_color ${P[cursor_text]}),
      "Selection Color": $(iterm_color ${P[selection]}),
      "Selected Text Color": $(iterm_color ${P[selection_text]}),
EOF
  for i in {0..15}; do
    printf '      "Ansi %d Color": %s%s\n' $i "$(iterm_color ${P[color$i]})" $([[ $i -lt 15 ]] && print -n ,)
  done
  cat <<EOF
    }
  ]
}
EOF
}

render_ghostty() {
  local i
  print -- "# Generated by \`theme apply ${P[name]}\`. Edit the palette, not this file."
  for i in {0..15}; do print -- "palette = $i=${P[color$i]}"; done
  print -- "background = ${P[background]}"
  print -- "foreground = ${P[foreground]}"
  print -- "cursor-color = ${P[cursor]}"
  print -- "cursor-text = ${P[cursor_text]}"
  print -- "selection-background = ${P[selection]}"
  print -- "selection-foreground = ${P[selection_text]}"
}

render_tmux() {
  cat <<EOF
# Generated by \`theme apply ${P[name]}\`. Edit the palette, not this file.
set -g status-style "bg=${P[color0]},fg=${P[foreground]}"
set -g status-left-length 30
set -g status-left "#[bg=${P[color4]},fg=${P[background]},bold] #S #[default] "
set -g status-right "#[fg=${P[color7]}]%H:%M #[bg=${P[color8]},fg=${P[foreground]}] #h "
set -g window-status-format " #I #W "
set -g window-status-current-format "#[bg=${P[color8]},fg=${P[color15]},bold] #I #W "
set -g window-status-activity-style "fg=${P[color3]}"
set -g pane-border-style "fg=${P[color8]}"
set -g pane-active-border-style "fg=${P[color4]}"
set -g message-style "bg=${P[color3]},fg=${P[background]}"
set -g message-command-style "bg=${P[color8]},fg=${P[foreground]}"
set -g mode-style "bg=${P[selection]},fg=${P[selection_text]}"
set -g clock-mode-colour "${P[color4]}"
EOF
}

# ------------------------------------------------------------- notifiers ---

# Send an OSC sequence to the controlling terminal, tunnelling through tmux if needed.
osc() {
  local s=$1
  if [[ -n ${TMUX-} ]]; then
    s=${s//$'\e'/$'\e\e'}
    s=$'\ePtmux;'$s$'\e\\'
  fi
  print -n -- $s > /dev/tty
}

# Recolor the terminal this command runs in via standard OSC 4/10/11/12/17/19.
recolor_tty() {
  [[ -t 1 && -w /dev/tty ]] || return 0
  # iTerm sessions follow the dynamic profile, and an OSC override would stop that.
  [[ ${TERM_PROGRAM-} == iTerm.app ]] && return 0
  local i s=""
  for i in {0..15}; do s+=$'\e]4;'"$i;${P[color$i]}"$'\a'; done
  s+=$'\e]10;'${P[foreground]}$'\a'
  s+=$'\e]11;'${P[background]}$'\a'
  s+=$'\e]12;'${P[cursor]}$'\a'
  s+=$'\e]17;'${P[selection]}$'\a'
  s+=$'\e]19;'${P[selection_text]}$'\a'
  osc $s
}

install_iterm_profile() {
  [[ $(uname -s) == Darwin ]] || return 0
  mkdir -p $ITERM_DYNAMIC_DIR
  cp $STATE_DIR/iterm2-profiles.json "$ITERM_DYNAMIC_DIR/dotfiles-theme.json"
}

reload_tmux() {
  command -v tmux > /dev/null || return 0
  tmux info > /dev/null 2>&1 || return 0
  tmux source-file $STATE_DIR/tmux.conf
}

# -------------------------------------------------------------- commands ---

# Name of the applied theme, or empty. (Never `exit` inside $(...): under
# ERR_EXIT zsh 5.9 kills the parent shell even when the call is guarded.)
current_name() {
  [[ -f $STATE_DIR/current ]] && cat $STATE_DIR/current || print -n ""
}

cmd_current() {
  local name=$(current_name)
  [[ -n $name ]] || die "no theme applied yet (run: theme apply $DEFAULT_THEME)"
  print -- $name
}

cmd_list() {
  local names_only=0 dir name mark current i r g b
  [[ ${1-} == --names ]] && names_only=1
  current=$(current_name)
  for dir in $THEMES_DIR/*(/N); do
    name=${dir:t}
    if (( names_only )); then print -- $name; continue; fi
    load_palette $dir/palette.conf
    mark=" "; [[ $name == $current ]] && mark="*"
    printf '%s %-18s %-22s' $mark $name "${P[description]-}"
    if [[ -t 1 ]]; then
      for i in {0..7}; do
        read -r r g b <<< "$(rgb ${P[color$i]})"
        printf '\e[48;2;%d;%d;%dm  ' $r $g $b
      done
      printf '\e[0m'
    fi
    print
  done
}

cmd_apply() {
  local name=${1-}
  [[ -n $name ]] || die "usage: theme apply <name>"
  local file=$THEMES_DIR/$name/palette.conf
  [[ -f $file ]] || die "unknown theme '$name' (see: theme list)"
  load_palette $file

  mkdir -p $STATE_DIR
  render_iterm > $STATE_DIR/iterm2-profiles.json
  render_ghostty > $STATE_DIR/ghostty.conf
  render_tmux > $STATE_DIR/tmux.conf
  cp $file $STATE_DIR/palette.conf
  print -- $name > $STATE_DIR/current

  install_iterm_profile
  reload_tmux
  recolor_tty

  print -- "Applied $name."
  print -- "  neovim: takes effect in new instances"
  [[ ${TERM_PROGRAM-} == ghostty ]] && print -- "  ghostty: other windows update after reload_config (⌘⇧,)"
  return 0
}

cmd_setup() {
  local name=$(current_name)
  cmd_apply "${name:-$DEFAULT_THEME}"
  if [[ $(uname -s) == Darwin ]]; then
    defaults write com.googlecode.iterm2 "Default Bookmark Guid" -string $ITERM_GUID
    print -- "  iterm: \"$ITERM_PROFILE_NAME\" is now the default profile (restart iTerm if it was running)"
  fi
}

case ${1-} in
  list)    shift; cmd_list "$@" ;;
  current) cmd_current ;;
  apply)   shift; cmd_apply "$@" ;;
  setup)   cmd_setup ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command '$1' (see: theme --help)" ;;
esac
